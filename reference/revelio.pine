//@version=6
indicator("Turtle Breakout - Revelio", shorttitle="Turtle Breakout", overlay=true, max_lines_count=100)

// Long-only breakout system, as tested in the video.
// Trading days run from 17:00 to 17:00 New York. Bands and ATR use completed days only.
// Entry: the price goes above the highest high of the last 20 days.
// Stop loss: 2 ATR below the entry price, fixed for the whole trade (standard 20-day ATR, Wilder's smoothing).
// Trailing exit: the lowest low of the last 10 days. The trade exits at whichever of the two is higher.
// Day-trading mode: close at 16:30 New York, re-enter from 18:00 if the trade is still valid, flat over the weekend.
// This is an indicator: it draws and alerts, it does not place orders.
// Blue shading = position held.

const string TZ = "America/New_York"
const int ROLLOVER_M = 17 * 60
int N = input.int(20, "Entry: highest high of the last N days", minval=2, maxval=400, group="Rules")
int M = input.int(10, "Exit: lowest low of the last M days", minval=2, maxval=400, group="Rules")
int atrLen = input.int(20, "ATR length (days)", minval=2, maxval=400, group="Rules")
float atrMult = input.float(2.0, "Stop loss (ATR multiple below entry)", minval=0.5, step=0.5, group="Rules")
bool dayTrading = input.bool(true, "Day-trading mode: close before the rollover, re-enter after", group="Schedule")
int closeH = input.int(16, "Close at (New York time)", minval=0, maxval=23, inline="close", group="Schedule")
int closeMin = input.int(30, ":", minval=0, maxval=55, step=5, inline="close", group="Schedule")
int openH = input.int(18, "Re-enter from (New York time)", minval=0, maxval=23, inline="open", group="Schedule")
int openMin = input.int(0, ":", minval=0, maxval=55, step=5, inline="open", group="Schedule")
bool showBg = input.bool(true, "Shade candles while in position", group="Display")

int CLOSE_M = closeH * 60 + closeMin
int OPEN_M = openH * 60 + openMin
if barstate.isfirst
    if not chart.is_standard or not timeframe.isminutes or timeframe.multiplier > 30 or 30 % timeframe.multiplier != 0
        runtime.error("Use regular candles on a 1, 5, 15 or 30-minute chart.")
    if dayTrading and CLOSE_M >= OPEN_M
        runtime.error("The close time must be earlier than the re-entry time.")
    if dayTrading and (CLOSE_M % timeframe.multiplier != 0 or OPEN_M % timeframe.multiplier != 0)
        runtime.error("Close and re-entry times must fall on a candle boundary of this chart (for example 16:30 and 18:00 on a 30-minute chart).")

// Calendar arithmetic keeps local clock times fixed through daylight saving and month/year changes.
nyTime(int t, int dayOffset, int h, int m) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ) + dayOffset, h, m)

deadlineFor(int t) =>
    int mins = hour(t, TZ) * 60 + minute(t, TZ)
    int d = nyTime(t, mins >= CLOSE_M ? 1 : 0, 0, 0)
    while dayofweek(d, TZ) == dayofweek.saturday or dayofweek(d, TZ) == dayofweek.sunday
        d := nyTime(d, 1, 0, 0)
    nyTime(d, 0, closeH, closeMin)

remember(array<float> values, float value, int length) =>
    array.push(values, value)
    if array.size(values) > length
        array.shift(values)

int nyMin = hour(time, TZ) * 60 + minute(time, TZ)
int nyDow = dayofweek(time, TZ)
int sessionStart = nyTime(time, nyMin < ROLLOVER_M ? -1 : 0, int(ROLLOVER_M / 60), ROLLOVER_M % 60)
bool newSession = na(sessionStart[1]) or sessionStart != sessionStart[1]
var array<float> highs = array.new_float()
var array<float> lows = array.new_float()
var float atr = na
var float atrSeed = 0.0
var int atrCount = 0
var float dHigh = na
var float dLow = na
var float dClose = na
var float prevClose = na
var bool skipFirst = true

// Discard the first loaded day (usually incomplete). Only completed days update the bands and the ATR.
if barstate.isconfirmed
    if newSession
        if not na(dHigh)
            if skipFirst
                skipFirst := false
            else
                remember(highs, dHigh, N)
                remember(lows, dLow, M)
                float tr = na(prevClose) ? dHigh - dLow : math.max(dHigh - dLow, math.max(math.abs(dHigh - prevClose), math.abs(dLow - prevClose)))
                if na(atr)
                    atrSeed += tr
                    atrCount += 1
                    if atrCount == atrLen
                        atr := atrSeed / atrLen
                else
                    atr := (atr * (atrLen - 1) + tr) / atrLen
                prevClose := dClose
        dHigh := high
        dLow := low
        dClose := close
    else
        dHigh := math.max(dHigh, high)
        dLow := math.min(dLow, low)
        dClose := close

float entryLevel = array.size(highs) == N ? array.max(highs) : na
float exitLevel = array.size(lows) == M ? array.min(lows) : na
bool allowed = not dayTrading or ((nyMin < CLOSE_M or nyMin >= OPEN_M) and nyDow != dayofweek.saturday and not (nyDow == dayofweek.sunday and nyMin < OPEN_M) and not (nyDow == dayofweek.friday and nyMin >= CLOSE_M))

var bool signalLong = false
var bool held = false
var float stop = na
var int deadline = na
var bool signalMarked = false
var int signalStart = na
var float signalPrice = na
var int lastHeldTime = na
var float lastHeldPrice = na
bool entryEvent = false
bool reentryEvent = false
bool closeEvent = false
bool exitEvent = false
bool shadeHeld = held and (not dayTrading or time < deadline)
float entryMark = na
float exitMark = na
bool exitWhileFlat = false

if barstate.isconfirmed and not na(entryLevel) and not na(exitLevel) and not na(atr)
    bool wasLong = signalLong
    bool breakout = not wasLong and high > entryLevel
    float signalExit = na
    if breakout
        signalMarked := false
        stop := math.max(entryLevel, open) - atrMult * atr
        signalLong := true
        exitEvent := low < stop
    else if wasLong
        exitEvent := low < math.max(stop, exitLevel)
    if exitEvent
        signalExit := wasLong ? math.min(open, math.max(stop, exitLevel)) : stop
        signalLong := false

    // Handling missing candles for daily break or weekend.
    if dayTrading and held and time >= deadline
        lastHeldTime := time
        lastHeldPrice := open
        held := false
        closeEvent := true
    if not held and allowed
        entryEvent := breakout
        reentryEvent := wasLong and open >= math.max(stop, exitLevel)
        if entryEvent or reentryEvent
            if not signalMarked
                entryMark := breakout ? math.max(entryLevel, open) : open
                signalStart := time
                signalPrice := entryMark
                signalMarked := true
            held := true
            deadline := deadlineFor(time)

    // Include the closing candle in the shading.
    shadeHeld := held

    // Re-entry uses the open, so a stop hit later in the same candle still closes the position.
    if held
        lastHeldTime := time
        lastHeldPrice := exitEvent ? signalExit : close
        if exitEvent
            held := false
        else if dayTrading and time_close == deadline
            held := false
            closeEvent := true

    // Dashed line to highlight the whole trade.
    if exitEvent and signalMarked
        exitWhileFlat := not shadeHeld
        exitMark := exitWhileFlat ? math.max(stop, exitLevel) : signalExit
        line.new(signalStart, signalPrice, lastHeldTime, lastHeldPrice, xloc=xloc.bar_time, color=lastHeldPrice >= signalPrice ? color.lime : color.red, style=line.style_dashed)
        signalMarked := false

float activeStop = signalLong ? math.max(stop, exitLevel) : na
plot(entryLevel, "Entry band", color=color.teal, linewidth=2, style=plot.style_stepline)
plot(exitLevel, "Exit band", color=color.orange, style=plot.style_stepline, trackprice=true)
plot(activeStop, "Active exit (higher stop)", color=color.red, linewidth=2, style=plot.style_linebr)
bgcolor(showBg and shadeHeld ? color.new(#2962FF, 80) : na, title="Position held")
plotshape(entryMark, title="Entry", style=shape.triangleup, location=location.absolute, color=color.lime, size=size.small, display=display.pane)
plotshape(exitMark, title="Exit", style=shape.xcross, location=location.absolute, color=exitWhileFlat ? color.gray : color.red, size=size.small, display=display.pane)

// Exit ends the trade signal.
// Re-entry for dayTrading mode also covers the first entry after a breakout that happened during the break.
alertcondition(entryEvent, "Entry", "Turtle: entry signal on {{ticker}}; confirmed at candle close.")
alertcondition(reentryEvent, "Re-entry", "Turtle: re-entry signal on {{ticker}}; confirmed at candle close.")
alertcondition(closeEvent, "Scheduled close", "Turtle: scheduled close on {{ticker}} (or first quote after a missed close); confirmed at candle close.")
alertcondition(exitEvent, "Signal exit", "Turtle: trade signal ended on {{ticker}} (you may already be flat by schedule); confirmed at candle close.")
